# ---------------------------------------------------------------------------
# Release
# ---------------------------------------------------------------------------
# Carrot Mapper image version to deploy (5.0.0 or later), see
# https://github.com/orgs/Health-Informatics-UoN/packages?repo_name=carrot-mapper
RELEASE_VERSION=5.0.3

# ---------------------------------------------------------------------------
# Public URLs
# ---------------------------------------------------------------------------
# URLs that users' browsers use to reach each service. Change these when
# deploying on a VM that is accessed from other machines.
FRONTEND_URL=http://localhost:3000
AIRFLOW_URL=http://localhost:8080
# Keycloak must be reachable on the same URL from browsers AND from the
# airflow-api container. keycloak.localtest.me always resolves to 127.0.0.1,
# so this default only works when the browser runs on the Docker host.
KEYCLOAK_HOSTNAME=http://keycloak.localtest.me:8085

# ---------------------------------------------------------------------------
# OMOP vocabularies
# ---------------------------------------------------------------------------
# true: load synthetic vocabularies. false: load Athena vocabularies from ./vocabs
SYNTHETIC_VOCABS=true

# ---------------------------------------------------------------------------
# Database (Postgres)
# ---------------------------------------------------------------------------
# Used by Carrot, Airflow, Keycloak and OMOP Lite. The password is also used
# inside connection URIs, so URL-encode any special characters.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# ---------------------------------------------------------------------------
# Carrot Mapper API (Django)
# ---------------------------------------------------------------------------
# Django debug mode. The images have been run with True; set False only after checking static files still load.
DEBUG=True
SECRET_KEY=secret
SIGNING_KEY=secret
# Superuser created on first start, used to log in to the frontend and Django Admin.
SUPERUSER_DEFAULT_USERNAME=admin
SUPERUSER_DEFAULT_PASSWORD=admin
SUPERUSER_DEFAULT_EMAIL=admin@carrot.com
# Maximum upload size in bytes (30 MB), used by both the API and the frontend.
DATA_UPLOAD_MAX_MEMORY_SIZE=31457280

# ---------------------------------------------------------------------------
# Carrot Mapper frontend (Next.js)
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=verycomplexsecretkey

# ---------------------------------------------------------------------------
# Storage (RustFS, S3-compatible)
# ---------------------------------------------------------------------------
S3_ACCESS_KEY=s3admin
S3_SECRET_KEY=s3admin

# ---------------------------------------------------------------------------
# Airflow
# ---------------------------------------------------------------------------
AIRFLOW_API_SECRET_KEY=test-airflow-secret-key
AIRFLOW_API_AUTH_JWT_SECRET=Bdta/xfhDGy5yGPLHe5rfA==
# A user in the Keycloak CARROT-MAPPER realm. The API uses it to trigger DAGs,
# and you can use it to log in to the Airflow UI.
AIRFLOW_ADMIN_USERNAME=carrot-admin
AIRFLOW_ADMIN_PASSWORD=password123
# Must match the CARROT-AIRFLOW client secret in realm-config/Carrot-Mapper.json.
AIRFLOW_OPENID_CLIENT_SECRET=QXFtCMyTjwYzCK07qGTp9s95n5u5eVyB

# ---------------------------------------------------------------------------
# Keycloak
# ---------------------------------------------------------------------------
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=admin
# start-dev is for local use only. Use `start` (which requires HTTPS) in production.
KEYCLOAK_STARTUP_COMMAND=start-dev
